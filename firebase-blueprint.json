{
  "entities": {
    "PortfolioConfig": {
      "title": "Portfolio Configuration",
      "description": "Global portfolio settings, theme selections, and content",
      "type": "object",
      "properties": {
        "activeTemplateId": {
          "type": "string",
          "maxLength": 64
        },
        "activeTheme": {
          "type": "string",
          "maxLength": 32
        },
        "customColors": {
          "type": "object"
        },
        "personalInfo": {
          "type": "object"
        },
        "stats": {
          "type": "array"
        },
        "experience": {
          "type": "array"
        },
        "skills": {
          "type": "array"
        },
        "services": {
          "type": "array"
        },
        "projects": {
          "type": "array"
        },
        "testimonials": {
          "type": "array"
        },
        "faqs": {
          "type": "array"
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64
        },
        "updatedBy": {
          "type": "string",
          "maxLength": 128
        }
      },
      "required": ["activeTemplateId", "activeTheme", "personalInfo"]
    },
    "ContactMessage": {
      "title": "Contact Inquiry",
      "description": "Visitor contact message or WhatsApp pre-inquiry record",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "maxLength": 150
        },
        "phone": {
          "type": "string",
          "maxLength": 50
        },
        "service": {
          "type": "string",
          "maxLength": 100
        },
        "budget": {
          "type": "string",
          "maxLength": 50
        },
        "message": {
          "type": "string",
          "maxLength": 2000
        },
        "status": {
          "type": "string",
          "enum": ["unread", "read", "responded", "archived"]
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": ["name", "email", "message"]
    }
  },
  "firestore": {
    "/portfolio/data": {
      "schema": "PortfolioConfig",
      "description": "Global portfolio configuration document read by all visitors and managed by admin"
    },
    "/messages/{messageId}": {
      "schema": "ContactMessage",
      "description": "Client contact messages received from the portfolio website"
    }
  }
}
